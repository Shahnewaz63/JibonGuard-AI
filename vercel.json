{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/daily-maintenance", "schedule": "0 0 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__jg_path="
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__jg_path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
