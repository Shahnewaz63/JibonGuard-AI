# SMTP account email delivery (required to send sign-up and sign-in OTPs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Separate admin authentication. Generate a random 32+ character encryption key before use.
ADMIN_ENCRYPTION_KEY=
# Shared secret that authorizes super-admin sign-up at /admin; use a random value of at least 32 characters.
ADMIN_SIGNUP_KEY=
# Optional comma-separated source IP allowlist for the separate admin panel.
ADMIN_IP_ALLOWLIST=
# PostgreSQL connection string. When set, the application uses PostgreSQL instead of SQLite.
DATABASE_URL=
# Admin sessions are intentionally short lived; values are seconds.
ADMIN_SESSION_LIFETIME_SECONDS=3600

# Idempotent billing/usage rollup job interval (milliseconds; minimum 60,000).
BILLING_ROLLUP_INTERVAL_MS=86400000
BILLING_LIFECYCLE_INTERVAL_MS=3600000

# Optional: Open-Meteo customer API key for commercial use.
OPEN_METEO_API_KEY=

# TextBee SMS gateway (keep credentials on the server; never add them to browser code).
TEXTBEE_API_KEY=
# Optional but recommended for instant incoming SMS and emergency-code handling.
# Set the same 32+ character secret in the TextBee webhook subscription.
TEXTBEE_WEBHOOK_SECRET=
# Optional; leave blank to use the sending phone's default SIM.
TEXTBEE_SIM_SUBSCRIPTION_ID=
# Optional: TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# Gemini API (server-side only; never put the key in browser JavaScript).
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: TTS model for reading chatbot replies aloud.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Alert automation runs only for organizations that enable it in the dashboard.
# Set AI_ALERTS_ENABLED=true to allow the optional model decision layer.
ALERT_AUTOMATION_ENABLED=true
AI_ALERTS_ENABLED=false
AI_ALERTS_MODEL=gemini-3.5-flash-lite
AI_ALERTS_TIMEOUT_MS=8000
AI_ALERTS_RETRIES=1
ALERT_AUTOMATION_INTERVAL_MS=900000
ALERT_HEAT_TRIGGER_C=34
ALERT_RAIN_LEAD_MINUTES=120
ALERT_RAIN_PROBABILITY=60
ALERT_COOLDOWN_MINUTES=40
ALERT_DAILY_CAP=4
ALERT_QUIET_START=20:00
ALERT_QUIET_END=06:00
# Optional HTTPS voice service adapter (SMS remains the built-in TextBee path).
VOICE_GATEWAY_URL=
VOICE_GATEWAY_API_KEY=

# Optional feature suite. Every feature also requires organization opt-in.
# Safe defaults keep all new AI and scheduled behavior disabled until reviewed.
NOWCAST_ENABLED=false
NOWCAST_MODEL_PATH=ml/models/nowcast.json
NOWCAST_INTERVAL_MS=900000
NOWCAST_MAX_MODEL_AGE_DAYS=120
SMART_BREAK_SCHEDULER_ENABLED=false
BREAK_SCHEDULER_CREW_COUNT=4
BREAK_REMINDER_DAILY_CAP=6
TRIAGE_ENABLED=false
AI_TRIAGE_ENABLED=false
TRIAGE_RETENTION_DAYS=30
TRIAGE_RATE_LIMIT_PER_HOUR=3
TRIAGE_EMERGENCY_NUMBER=999
TRIAGE_ALERT_NEARBY_WORKERS=false
AI_SAFETY_REPORTS_ENABLED=false
SAFETY_REPORT_DAILY_TIME=18:00
SAFETY_REPORT_WEEKLY_DAY=4
SAFETY_REPORT_WEEK_START=6
SAFETY_REPORT_EMAIL_ENABLED=false
OFFICIAL_ADVISORIES_ENABLED=true
OFFICIAL_FEED_URL=
OFFICIAL_FEED_FORMAT=cap
OFFICIAL_FEED_INTERVAL_MS=900000
OFFICIAL_ADVISORY_HIGH_SEVERITY_FLOOR=High
