# Optional: Open-Meteo customer API key for commercial use.
OPEN_METEO_API_KEY=

# TextBee SMS gateway (keep credentials on the server; never add them to browser code).
TEXTBEE_API_KEY=
# Optional; leave blank to use the sending phone's default SIM.
TEXTBEE_SIM_SUBSCRIPTION_ID=
# Optional: TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# Gemini API (server-side only; never put the key in browser JavaScript).
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-3.5-flash-lite

# Alert automation runs only for organizations that enable it in the dashboard.
# Set AI_ALERTS_ENABLED=true to allow the optional model decision layer.
ALERT_AUTOMATION_ENABLED=true
AI_ALERTS_ENABLED=false
AI_ALERTS_MODEL=gemini-3.5-flash-lite
AI_ALERTS_TIMEOUT_MS=8000
AI_ALERTS_RETRIES=1
ALERT_AUTOMATION_INTERVAL_MS=720000
ALERT_HEAT_TRIGGER_C=34
ALERT_RAIN_LEAD_MINUTES=120
ALERT_RAIN_PROBABILITY=60
ALERT_COOLDOWN_MINUTES=40
ALERT_DAILY_CAP=4
ALERT_QUIET_START=20:00
ALERT_QUIET_END=06:00
# Optional HTTPS voice service adapter (SMS remains the built-in TextBee path).
VOICE_GATEWAY_URL=
VOICE_GATEWAY_API_KEY=
